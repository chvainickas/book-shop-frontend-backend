# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Backend (Rails)
backend/.bundle
backend/.env*
backend/log/*
!backend/log/.keep
backend/tmp/*
!backend/tmp/.keep
backend/storage/*
!backend/storage/.keep
backend/public/assets
backend/app/assets/builds/*
!backend/app/assets/builds/.keep
backend/config/*.key
backend/vendor/bundle/
*.sqlite3
*.sqlite3-*

# Frontend (React)
frontend/node_modules/
frontend/.env*
frontend/build/
frontend/dist/

# General
notes/
*.log
.DS_Store
